{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threads-tools",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threads-tools-production",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ]
}
