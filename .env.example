# Server-only configuration. Never expose or commit real values.
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=http://localhost:3000/auth/threads/callback
THREADS_API_BASE_URL=https://graph.threads.com
THREADS_API_VERSION=v1.0
SESSION_SECRET=replace_with_at_least_32_random_characters

# SparkPod / Daytona runtime. In production, DAYTONA_API_KEY MUST be a Cloudflare Secret.
DAYTONA_API_KEY=replace_with_daytona_api_key_for_local_development_only
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Phase 5.1 owner-only Cloudflare bridge bootstrap.
# Create a PRIVATE OAuth client. Keep the client secret server-side only.
CLOUDFLARE_OAUTH_CLIENT_ID=your_private_cloudflare_oauth_client_id
CLOUDFLARE_OAUTH_CLIENT_SECRET=your_private_cloudflare_oauth_client_secret
# Space-separated exact scope identifiers selected in the OAuth client.
CLOUDFLARE_OAUTH_SCOPES=copy_exact_scope_ids_from_cloudflare

# Signed Cloudflare Access owner assertion verification.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# One tag, or comma-separated exact audience tags when both custom and pages.dev hostnames are protected.
CF_ACCESS_AUD=your_custom_domain_aud,your_pages_dev_aud
OWNER_EMAIL=owner@example.com
